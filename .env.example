# Vercel & Application Environment Variables
#
# The canonical production origin is defined in lib/site.ts (site.url) and is
# used for canonical, Open Graph, Twitter, JSON-LD, robots and sitemap URLs.
# It is intentionally NOT read from the environment, so a stale or preview
# value can never leak into production metadata. This entry documents the
# expected value only.
NEXT_PUBLIC_SITE_URL=https://sibin-p.vercel.app

# Optional Contact Form Email Service (e.g. Resend / SendGrid / Formspree)
# Not used: the contact form opens the visitor's own mail app via mailto:.
# RESEND_API_KEY=re_123456789
# CONTACT_EMAIL_TO=puthramannilshibin@gmail.com
